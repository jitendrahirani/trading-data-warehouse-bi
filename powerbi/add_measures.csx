// Phase 6: adds every measure of bi/etl/semantic_model.py that the _Measures table does not have yet.
// GENERATED by bi/etl/build_phase6_artifacts.py - do not edit by hand.
// Run in Tabular Editor 2 opened from Power BI Desktop (External Tools > Tabular Editor) > C# Script > Run (F5),
// then File > Save (Ctrl+S) to write the measures back into Power BI Desktop.
if (!Model.Tables.Contains("_Measures")) { Error("Create the _Measures table first (build guide, Part C step 1)."); return; }
if (!Model.Tables.Contains("Threshold")) { Error("Create the Threshold what-if parameter first (build guide, Part C step 4)."); return; }
var t = Model.Tables["_Measures"];
var added = new System.Collections.Generic.List<string>();
var kept = new System.Collections.Generic.List<string>();
System.Action<string, string, string, string, string> add = (name, folder, fmt, desc, expr) => {
    if (t.Measures.Contains(name)) { kept.Add(name); return; }
    var m = t.AddMeasure(name, expr, folder);
    if (fmt != "") m.FormatString = fmt;
    m.Description = desc;
    added.Add(name);
};
add(@"Checks Evaluated", @"1 Data quality", @"#,0", @"DQ findings in the resolved (latest) runs. (K02)",
    @"SUM ( DQDailyStatus[Checks Evaluated] )");
add(@"Pass + Note", @"1 Data quality", @"#,0", @"Findings with severity pass or note in the resolved runs. (K03)",
    @"SUM ( DQDailyStatus[Pass] ) + SUM ( DQDailyStatus[Note] )");
add(@"DQ Pass Rate", @"1 Data quality", @"0.0%", @"(Pass + note) / checks evaluated. Green >= 95 %, red < 94 % (set from the real distribution). (K03)",
    @"DIVIDE ( [Pass + Note], [Checks Evaluated] )");
add(@"FAILs", @"1 Data quality", @"#,0", @"Findings with severity fail in the resolved runs.",
    @"COALESCE ( SUM ( DQDailyStatus[Fail] ), 0 )");
add(@"Unresolved FAILs", @"1 Data quality", @"#,0", @"FAILs in consumed datasets with no by-design rule and no written decision (day-level + minute-level). (K04)",
    @"COALESCE ( SUM ( DQDailyStatus[Unresolved Day FAILs] ) + SUM ( DQDailyStatus[Unresolved Minute FAILs] ), 0 )");
add(@"Warn + Fail Findings", @"1 Data quality", @"#,0", @"Findings with severity warn or fail in the resolved runs.",
    @"CALCULATE ( COUNTROWS ( DQFinding ), DQFinding[Is Resolved Run] = TRUE (), Severity[Is Problem] = TRUE () )");
add(@"Known-Cause FAILs and WARNs", @"1 Data quality", @"#,0", @"Warn/fail findings that carry a known cause (context only: a known cause does not resolve a FAIL). (K05)",
    @"COALESCE ( CALCULATE ( COUNTROWS ( DQFinding ), DQFinding[Is Resolved Run] = TRUE (), DQFinding[Has Known Cause] = TRUE (), Severity[Is Problem] = TRUE () ), 0 )");
add(@"Cross-Source FAILs", @"1 Data quality", @"#,0", @"FAILs of the cross-source reconciliation checks X1-X8 in the resolved runs. (K08)",
    @"COALESCE ( CALCULATE ( COUNTROWS ( DQFinding ), DQFinding[Is Resolved Run] = TRUE (), 'Check'[Cross-Dataset] = TRUE (), Severity[Severity] = ""Fail"" ), 0 )");
add(@"Worst Dataset", @"1 Data quality", @"", @"Dataset(s) with the most warn + fail findings in the current filter (ties listed).",
    @"-- 'Dataset' must be quoted: DATASET is a reserved word in current DAX
VAR t = TOPN ( 1, VALUES ( 'Dataset'[Dataset] ), [Warn + Fail Findings], DESC )
RETURN CONCATENATEX ( t, 'Dataset'[Dataset], "", "", 'Dataset'[Dataset], ASC )");
add(@"Excluded Days", @"1 Data quality", @"#,0", @"Dates the production gate excluded. (K01)",
    @"COALESCE ( CALCULATE ( COUNTROWS ( DQDayVerdict ), DQDayVerdict[Verdict] = ""exclude"" ), 0 )");
add(@"Day Verdict", @"1 Data quality", @"", @"The gate's verdict for the selected date (ok / exclude / unchecked). (K01)",
    @"SELECTEDVALUE ( DQDayVerdict[Verdict], ""select one date"" )");
add(@"Rolling 20-Day Fail Rate", @"1 Data quality", @"0.000%", @"Unresolved FAILs / checks over the 20 trading days up to the selected date. (K06)",
    @"VAR cur = MAX ( 'Date'[Trading Day No] )
VAR win = CALCULATETABLE ( VALUES ( 'Date'[DateKey] ), REMOVEFILTERS ( 'Date' ),
    'Date'[Trading Day No] > cur - 20, 'Date'[Trading Day No] <= cur )
-- REMOVEFILTERS again: otherwise the outer filter on the selected date would intersect with the window
RETURN DIVIDE ( CALCULATE ( [Unresolved FAILs], REMOVEFILTERS ( 'Date' ), win ),
    CALCULATE ( [Checks Evaluated], REMOVEFILTERS ( 'Date' ), win ) )");
add(@"Days Since Unresolved FAIL", @"1 Data quality", @"#,0", @"Trading days since the latest date (up to the selected one) with an unresolved FAIL. (K07)",
    @"VAR cur = MAX ( 'Date'[Trading Day No] )
-- the per-day count is computed INSIDE CALCULATETABLE, where the date filters are removed
VAR days = CALCULATETABLE ( ADDCOLUMNS ( VALUES ( 'Date'[Trading Day No] ), ""@u"", [Unresolved FAILs] ),
    REMOVEFILTERS ( 'Date' ), 'Date'[Trading Day No] <= cur )
VAR lastDay = MAXX ( FILTER ( days, [@u] > 0 ), 'Date'[Trading Day No] )
RETURN IF ( NOT ISBLANK ( lastDay ), cur - lastDay )");
add(@"ETL Runs", @"2 Pipeline", @"#,0", @"ETL runs in the selection.",
    @"COUNTROWS ( EtlRun )");
add(@"Failed ETL Runs", @"2 Pipeline", @"#,0", @"ETL runs that ended Failed.",
    @"COALESCE ( CALCULATE ( COUNTROWS ( EtlRun ), EtlRun[Status] = ""Failed"" ), 0 )");
add(@"Last Successful Load", @"2 Pipeline", @"yyyy-mm-dd hh:nn", @"End time of the newest successful ETL run. (K10)",
    @"CALCULATE ( MAX ( EtlRun[Ended] ), EtlRun[Status] = ""Succeeded"" )");
add(@"Avg Run Duration (s)", @"2 Pipeline", @"#,0.0", @"Average ETL run duration in seconds. (K11)",
    @"AVERAGE ( EtlRun[Duration (s)] )");
add(@"ETL Reconciliation Breaks", @"2 Pipeline", @"#,0", @"Reconciliation checks with status BREAK. (K09)",
    @"COALESCE ( CALCULATE ( COUNTROWS ( Reconciliation ), Reconciliation[Status] = ""BREAK"" ), 0 )");
add(@"Rows Rejected", @"2 Pipeline", @"#,0", @"Source rows the ETL rejected (etl.RejectRow).",
    @"COALESCE ( SUM ( EtlStep[Rows Rejected] ), 0 )");
add(@"Predictions", @"3 Model", @"#,0", @"Out-of-fold predictions. (K14)",
    @"COUNTROWS ( ModelPrediction )");
add(@"Correct Predictions", @"3 Model", @"#,0", @"Predictions whose class equals the actual class.",
    @"CALCULATE ( [Predictions], ModelPrediction[Is Correct] = TRUE () )");
add(@"Accuracy", @"3 Model", @"0.0000", @"Correct / all. On a row of Actual Class it is that class's recall; on Predicted Class, its precision. (K12)",
    @"DIVIDE ( [Correct Predictions], [Predictions] )");
add(@"Balanced Accuracy", @"3 Model", @"0.0000", @"Average recall over the three classes. (K13)",
    @"AVERAGEX ( FILTER ( VALUES ( ActualClass[ActualClassKey] ), ActualClass[ActualClassKey] >= 0 && [Predictions] > 0 ), [Accuracy] )");
add(@"Macro F1", @"3 Model", @"0.0000", @"Average F1 over the three classes (a class never predicted counts as 0). (K13)",
    @"AVERAGEX (
    FILTER ( VALUES ( ActualClass[ActualClassKey] ), ActualClass[ActualClassKey] >= 0 ),
    VAR k = ActualClass[ActualClassKey]
    VAR tp = CALCULATE ( [Predictions], REMOVEFILTERS ( ActualClass ), REMOVEFILTERS ( PredictedClass ), ModelPrediction[ActualClassKey] = k, ModelPrediction[PredictedClassKey] = k )
    VAR act = CALCULATE ( [Predictions], REMOVEFILTERS ( ActualClass ), REMOVEFILTERS ( PredictedClass ), ModelPrediction[ActualClassKey] = k )
    VAR prd = CALCULATE ( [Predictions], REMOVEFILTERS ( ActualClass ), REMOVEFILTERS ( PredictedClass ), ModelPrediction[PredictedClassKey] = k )
    VAR pr = DIVIDE ( tp, prd, 0 )
    VAR rc = DIVIDE ( tp, act, 0 )
    RETURN DIVIDE ( 2 * pr * rc, pr + rc, 0 )
)");
add(@"Directional Precision", @"3 Model", @"0.0000", @"Among predictions of Up or Down: share correct. (K15)",
    @"DIVIDE ( CALCULATE ( [Correct Predictions], PredictedClass[Predicted Is Directional] = TRUE () ),
        CALCULATE ( [Predictions], PredictedClass[Predicted Is Directional] = TRUE () ) )");
add(@"Committed %", @"3 Model", @"0.0%", @"Share of predictions that are Up or Down (a trade would be placed). (K15)",
    @"DIVIDE ( CALCULATE ( [Predictions], PredictedClass[Predicted Is Directional] = TRUE () ), [Predictions] )");
add(@"Precision at Threshold", @"3 Model", @"0.0000", @"Directional precision among predictions with max probability >= the Threshold slicer. (K15)",
    @"VAR t = [Threshold Value]
RETURN DIVIDE (
    CALCULATE ( [Correct Predictions], PredictedClass[Predicted Is Directional] = TRUE (), ModelPrediction[Max Prob] >= t ),
    CALCULATE ( [Predictions], PredictedClass[Predicted Is Directional] = TRUE (), ModelPrediction[Max Prob] >= t ) )");
add(@"Coverage at Threshold", @"3 Model", @"0.0%", @"Share of all predictions that are Up/Down with max probability >= the Threshold slicer. (K15)",
    @"VAR t = [Threshold Value]
RETURN DIVIDE ( CALCULATE ( [Predictions], PredictedClass[Predicted Is Directional] = TRUE (), ModelPrediction[Max Prob] >= t ), [Predictions] )");
add(@"Frozen Report Accuracy", @"3 Model", @"0.0000", @"Accuracy as published in the frozen report (reconciliation target for [Accuracy]). (K12)",
    @"CALCULATE ( SUM ( ModelMetric[Value] ), ModelMetric[Metric] = ""accuracy"" )");
add(@"Total Importance", @"3 Model", @"0.0000", @"Sum of permutation importance (use per feature, top 15). (K16)",
    @"SUM ( FeatureImportance[Importance] )");
add(@"Drifted Features", @"3 Model", @"#,0", @"Features with PSI > 0.25 in a PSI-reliable or range-skew section of a weekly drift report. (K24)",
    @"CALCULATE ( DISTINCTCOUNT ( FeatureDrift[FeatureKey] ), FeatureDrift[PSI] > 0.25, FeatureDrift[Section] IN { ""psi-reliable"", ""range-skew"" } )");
add(@"Trades", @"4 Trades", @"#,0", @"Simulated trades (by exit date). (K17)",
    @"COUNTROWS ( Trade )");
add(@"Net P&L", @"4 Trades", @"#,0.00", @"Option P&L after costs, Rs. (K18)",
    @"SUM ( Trade[Net P&L (Rs)] )");
add(@"Gross P&L", @"4 Trades", @"#,0.00", @"Option P&L before costs, Rs. (K19)",
    @"SUM ( Trade[Gross P&L (Rs)] )");
add(@"Costs", @"4 Trades", @"#,0.00", @"Entry + exit costs, Rs. (K19)",
    @"SUM ( Trade[Total Cost (Rs)] )");
add(@"Cost per Trade", @"4 Trades", @"#,0.00", @"Costs / trades, Rs. (K19)",
    @"DIVIDE ( [Costs], [Trades] )");
add(@"Cost % of Gross", @"4 Trades", @"0.0%", @"Costs / |gross P&L|: how much of the edge the costs eat. (K19)",
    @"DIVIDE ( [Costs], ABS ( [Gross P&L] ) )");
add(@"Win Rate", @"4 Trades", @"0.0%", @"Trades with net P&L > 0 / trades. (K20)",
    @"DIVIDE ( CALCULATE ( [Trades], Trade[Is Win] = TRUE () ), [Trades] )");
add(@"Avg Net per Trade", @"4 Trades", @"#,0.00", @"Net P&L / trades, Rs. (K20)",
    @"DIVIDE ( [Net P&L], [Trades] )");
add(@"Trades by Entry Date", @"4 Trades", @"#,0", @"Trades counted on their ENTRY date: the inactive relationship, switched on with USERELATIONSHIP.",
    @"CALCULATE ( [Trades], USERELATIONSHIP ( Trade[EntryDateKey], 'Date'[DateKey] ) )");
add(@"Cumulative Net P&L", @"4 Trades", @"#,0.00", @"Net P&L from the first trade up to the selected (or last) date. (K21)",
    @"VAR asOfDate = MAX ( 'Date'[Date] )
RETURN CALCULATE ( [Net P&L], REMOVEFILTERS ( 'Date' ), 'Date'[Date] <= asOfDate )");
add(@"Net P&L MTD", @"4 Trades", @"#,0.00", @"Month-to-date net P&L. (K23)",
    @"TOTALMTD ( [Net P&L], 'Date'[Date] )");
add(@"Net P&L FYTD", @"4 Trades", @"#,0.00", @"Indian fiscal-year-to-date net P&L (year ends 31 March). (K23)",
    @"TOTALYTD ( [Net P&L], 'Date'[Date], ""3/31"" )");
add(@"Drawdown", @"4 Trades", @"#,0.00", @"Cumulative net P&L minus its running peak (equity starts at 0), on the selected date. (K22)",
    @"VAR cur = MAX ( 'Date'[Date] )
VAR peak = MAXX ( FILTER ( ALL ( 'Date'[Date] ), 'Date'[Date] <= cur ), [Cumulative Net P&L] )
RETURN [Cumulative Net P&L] - MAX ( peak, 0 )");
add(@"Max Drawdown", @"4 Trades", @"#,0.00", @"Worst drawdown of the daily equity curve up to the selected date. (K22)",
    @"VAR asOfDate = MAX ( 'Date'[Date] )
VAR days = ADDCOLUMNS ( FILTER ( ALL ( 'Date'[Date] ), 'Date'[Date] <= asOfDate ), ""@net"", [Net P&L] )
VAR curve = ADDCOLUMNS ( days, ""@cum"", VAR d = 'Date'[Date] RETURN SUMX ( FILTER ( days, 'Date'[Date] <= d ), [@net] ) )
VAR peaks = ADDCOLUMNS ( curve, ""@peak"", VAR d = 'Date'[Date] RETURN MAX ( 0, MAXX ( FILTER ( curve, 'Date'[Date] <= d ), [@cum] ) ) )
RETURN MINX ( peaks, [@cum] - [@peak] )");
add(@"Feature Daily Average", @"5 Features", @"0.000000", @"Minute-weighted average of the feature value (from the daily summary view).",
    @"DIVIDE ( SUMX ( FeatureValueDaily, FeatureValueDaily[Average] * FeatureValueDaily[Minutes] ), SUM ( FeatureValueDaily[Minutes] ) )");
Info("Added " + added.Count + " measures. Already there (typed by you, left unchanged): " + string.Join(", ", kept));
